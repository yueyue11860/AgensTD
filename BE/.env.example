PORT=3000
CORS_ORIGIN=*
AUTH_REQUIRED=true
HUMAN_GATEWAY_TOKEN=human-dev-token
AGENT_GATEWAY_TOKEN=agent-dev-token
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 生产持久化必须为 supabase；memory 仅限本地开发/测试。
PVP_STORE=memory
PVE_REWARD_STORE=memory
PVE_CHECKPOINT_STORE=memory
# 固定 tick checkpoint 间隔；关键 PVE action 应用后会额外立即保存。
PVE_CHECKPOINT_EVERY_TICKS=50
PERSISTENCE_FLUSH_EVERY_TICKS=50
FULL_SNAPSHOT_INTERVAL_MS=5000
VERBOSE_GAME_LOGS=false
REPLAY_MAX_FRAMES=300
REPLAY_MAX_ACTIONS=500

# 真人登录由 Supabase Auth 管理。浏览器使用 VITE_SUPABASE_URL +
# VITE_SUPABASE_ANON_KEY；后端使用上方 service role 验证 JWT 并同步游戏资料。
# PVP 完整战斗客户端未通过验收前，生产默认保持 false。
PVP_RANKED_ENABLED=false
